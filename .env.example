# Supabase 연결 정보 (브라우저에 노출되어도 되는 공개 값만 사용)
# 실제 값은 .env.local 에 넣고 절대 커밋하지 않습니다.
# service_role 키는 프론트엔드/저장소에 절대 포함하지 마세요.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 카카오맵 — developers.kakao.com에서 JavaScript 키 발급 후 입력.
# 플랫폼 Web 허용 도메인: https://nongsadama.app, https://radlerner.github.io,
# http://localhost, http://localhost:5173
# Supabase map_config 값을 우선 권장. 이 값은 로컬·긴급 폴백용 선택 항목.
VITE_KAKAO_MAP_KEY=

# (선택) Google Analytics 4 — 측정 ID(G-XXXX, 공개값). 배포에만 설정하고
# 로컬 dev에서는 비워 두어 개발 트래픽이 통계에 섞이지 않게 한다.
VITE_GA_MEASUREMENT_ID=

# 외부 음성인식(STT) — POST multipart(file,language) → {"text":...} 계약의
# Supabase Edge Function 주소. 운영 웹·Android 릴리스 빌드에 반드시 설정.
VITE_STT_ENDPOINT=
