# Supabase 연결 정보 (브라우저에 노출되어도 되는 공개 값만 사용)
# 실제 값은 .env.local 에 넣고 절대 커밋하지 않습니다.
# service_role 키는 프론트엔드/저장소에 절대 포함하지 마세요.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# (선택) 카카오맵 전환 — developers.kakao.com에서 JavaScript 키 발급 후 입력.
# 플랫폼 Web에 도메인 등록 필요: https://radlerner.github.io, http://localhost:5173
# 비우면 기본 지도(Leaflet+OSM) 사용. GitHub Pages 배포에는 저장소 Variables에도 추가.
VITE_KAKAO_MAP_KEY=

# (선택) Google Analytics 4 — 측정 ID(G-XXXX, 공개값). 배포에만 설정하고
# 로컬 dev에서는 비워 두어 개발 트래픽이 통계에 섞이지 않게 한다.
VITE_GA_MEASUREMENT_ID=

# (선택) 외부 음성인식(STT) 전환 — POST multipart(file,language) → {"text":...} 계약의
# 엔드포인트(예: Whisper 프록시). 비우면 브라우저 Web Speech 사용.
VITE_STT_ENDPOINT=
VITE_STT_KEY=
